# Supabase Auth / SSR
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase Auth uses server-managed app_metadata for engineering authorization.
# Example app_metadata:
# {"engineering_roles":["ENGINEER"],"engineering_project_ids":["PROJECT-ID"]}

# Optional server-side Chat Completions-compatible reasoning model transport.
# The reasoning workbench remains available for task/framework planning without these values.
# Use a provider endpoint that supports JSON-object response mode. Keep credentials server-only.
# For live-provider acceptance, configure equivalent variables in the GitHub Environment
# named reasoning-model-acceptance; never copy a provider key into the repository.
ENGINEERING_REASONING_MODEL_URL=
ENGINEERING_REASONING_MODEL_NAME=
ENGINEERING_REASONING_MODEL_API_KEY=
ENGINEERING_REASONING_MODEL_TIMEOUT_MS=45000

# Trusted CAD runtime (server-side only; never prefix these variables with NEXT_PUBLIC_)
# For production, use immutable image references ending in @sha256:<64-hex-digest>.
# The Docker daemon must be reachable by the app and able to mount the artifact root.
CAD_BUILD123D_IMAGE=
CAD_OCCT_IMAGE=
CAD_ARTIFACT_ROOT=/var/lib/engineering/cad-artifacts
CAD_DOCKER_BINARY=docker
CAD_OCCT_WORKER_PATH=worker/cad/occt/validate_brep.py

# Required for server-only trusted completion/evidence writes; keep this privileged key secret.
# Never expose it to the browser or commit a populated value.
SUPABASE_SERVICE_ROLE_KEY=

# Live CAD workspace smoke runner (set temporarily in a secure shell/CI secret store).
# Never commit a populated session cookie.
CAD_WORKSPACE_BASE_URL=
CAD_WORKSPACE_PROJECT_ID=
CAD_WORKSPACE_MODEL_ID=
CAD_WORKSPACE_COOKIE=
# Optional: also exercise the missing-dimension/no-artifact path.
CAD_WORKSPACE_TEST_NEEDS_INPUT=0
