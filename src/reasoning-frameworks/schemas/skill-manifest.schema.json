{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-mechanical-engineering-assistant.dev/schemas/skill-manifest.schema.json",
  "title": "Engineering Skill Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "description", "domains", "requiredInputs", "outputs", "allowedCapabilities", "maximumRisk", "requiresApproval"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "minLength": 1 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "domains": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "requiredInputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "outputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "allowedCapabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "maximumRisk": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "requiresApproval": { "type": "boolean" }
  }
}
